# canon-generate pipeline — bearer tokens and PAT.
# Copy to `.env` (gitignored, never commit real values) and fill in.
# Loaded by scripts/canon_common.py — a plain KEY=VALUE reader, no third-party deps.

# Live API bearer tokens — one per environment x Actor.
# Prefer scoped/least-privilege tokens where the platform's auth model allows it.
# Code-level GET-only enforcement (canon_fetch_live.py) protects the tool against
# PROD writes; it does not widen or narrow what a given token itself can do.
CANON_TOKEN_STAGING_VENDOR=
CANON_TOKEN_STAGING_OPERATIONS=
CANON_TOKEN_STAGING_CLIENT=
CANON_TOKEN_PROD_VENDOR=
CANON_TOKEN_PROD_OPERATIONS=
CANON_TOKEN_PROD_CLIENT=

# Azure DevOps Personal Access Token — Code (Read) scope only.
# Used by scripts/canon_repo_sync.py to clone/pull platform source repos.
CANON_AZDO_PAT=
